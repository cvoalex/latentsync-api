[Unit]
Description=LatentSync API Service
After=network.target

[Service]
Type=simple
User=your-username
WorkingDirectory=/path/to/latentsync
Environment="WEBSERVER_URL=https://your-api-server.com/"
Environment="API_AUTH_TOKEN=your-auth-token"
Environment="PYTORCH_ENABLE_MPS_FALLBACK=1"
ExecStart=/path/to/latentsync/venv/bin/python /path/to/latentsync/latentsync_service.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target